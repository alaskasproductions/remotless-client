#!/bin/bash

set -e

case $1 in
    remove|upgrade)
		INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
		rm -f /usr/bin/remotless

		if [ "systemd" == "${INITSYS}" ]; then
			systemctl stop remotless || true
			systemctl disable remotless || true
			rm /etc/systemd/system/remotless.service /usr/lib/systemd/system/remotless.service || true
			rm /usr/lib/systemd/user/remotless.service >/dev/null 2>&1 || true
		fi
        ;;
esac

exit 0
